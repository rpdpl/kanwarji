# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/vikas_local

# Auth
JWT_SECRET=secret-key-for-jwt

# Public URLs
SERVER_BASE_URL=http://localhost:5000
CLIENT_BASE_URL=http://localhost:5173

# Email
EMAIL_USER=
EMAIL_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Instamojo (set INSTAMOJO_SANDBOX=true + test keys from https://test.instamojo.com/integrations/)
# Live: INSTAMOJO_SANDBOX=false + keys from https://www.instamojo.com/integrations/
# SERVER_BASE_URL must be public HTTPS for redirect + webhook (use ngrok/cloudflared locally)
INSTAMOJO_SANDBOX=false
INSTAMOJO_API_KEY=
INSTAMOJO_AUTH_TOKEN=
INSTAMOJO_PRIVATE_SALT=

# Shiprocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_CHANNEL_ID=
SHIPROCKET_PICKUP_LOCATION=work
SHIPROCKET_PICKUP_POSTCODE=110006
SHIPROCKET_PICKUP_LAT=28.656090
SHIPROCKET_PICKUP_LONG=77.230721

