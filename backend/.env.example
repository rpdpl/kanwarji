# Server
PORT=5000
NODE_ENV=development

# Database (local empty DB or restored dump)
# Production VPS currently uses: mongodb://127.0.0.1:27017/test
MONGODB_URI=mongodb://127.0.0.1:27017/vikas_local

# Auth
JWT_SECRET=replace-with-a-long-random-string

# Public URLs (used for payment callbacks / redirects)
SERVER_BASE_URL=http://localhost:5000
CLIENT_BASE_URL=http://localhost:5173

# Email (Nodemailer — Gmail app password or SMTP)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=

# Cloudinary (product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Instamojo payments
INSTAMOJO_API_KEY=
INSTAMOJO_AUTH_TOKEN=
# Aliases also supported by code:
# INSTAMOJO_KEY=
# INSTAMOJO_TOKEN=

# Shiprocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_CHANNEL_ID=
