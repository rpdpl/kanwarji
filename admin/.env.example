# Admin calls backend routes like `${NEXT_PUBLIC_API_BASE_URL}/auth/login`
# and `${NEXT_PUBLIC_API_BASE_URL}/admin/stats`
#
# Include the `/api` prefix once here. Paths in code do NOT add another `/api`.
#
# Local:
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Production example (nginx proxies /api → Express, keeps /api):
# NEXT_PUBLIC_API_BASE_URL=https://kanwarji.in/api
