# Admin calls backend routes like `${NEXT_PUBLIC_API_BASE_URL}/auth/login`
# and `${NEXT_PUBLIC_API_BASE_URL}/admin/stats`
#
# So this must include the `/api` prefix that exists on the Express routes.
#
# Local:
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Production example (nginx typically mounts API under /api):
# NEXT_PUBLIC_API_BASE_URL=https://kanwarji.in/api/api
